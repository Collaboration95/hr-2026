  "eudr_definition_coverage": [
    {
      "element": "forest: land spanning more than 0.5 ha",
      "captured": "no",
      "note": "No layer or step here applies a contiguity or minimum-area test. The unit is one cell (0.076 ha Hansen, 0.0085 ha JRC at the chip latitude); 0.5 ha is about 6.6 Hansen cells or 59 JRC cells. JRC says its map follows the definition; that is unverified here."
    },
    {
      "element": "trees higher than 5 m",
      "captured": "partly",
      "note": "Hansen treecover2000 is canopy closure of vegetation taller than 5 m (dropped from L1/L2). JRC states the same threshold for its class. The decision layers carry no height information."
    },
    {
      "element": "canopy cover above 10%",
      "captured": "partly",
      "note": "Hansen treecover2000 > 10 would test it directly (a one-bit plane). The pipeline instead relies on the JRC class, so the threshold is applied only inside JRC, not by this code."
    },
    {
      "element": "or trees able to reach those thresholds in situ",
      "captured": "no",
      "note": "Young, recently cleared or regrowing stands are not distinguishable in a single-date map; Hansen gain is not used."
    },
    {
      "element": "excluding land predominantly under agricultural or urban use (agricultural plantations such as rubber and oil palm)",
      "captured": "only through JRC",
      "note": "JRC states it excludes plantations of relevant commodities other than wood. Hansen treats rubber and oil palm as tree cover, which is why Hansen loss alone fires on rotation harvests."
    },
    {
      "element": "cut-off 31 December 2020",
      "captured": "at year resolution",
      "note": "Hansen lossyear 21+ is after the cut-off; JRC is a 2020 reference year. Neither dates events within a year."
    },
    {
      "element": "deforestation = conversion of forest to agricultural use",
      "captured": "proxy",
      "note": "The count is mapped tree-cover loss on mapped 2020 forest. Hansen loss includes fire, logging and natural disturbance and says nothing about what the land becomes next."
    },
    {
      "element": "forest degradation, legality, protected areas",
      "captured": "no",
      "note": "Out of scope for these layers."
    }
  ],
