  "status": "estimate; every price is a list price assumption (no web lookup), verify before quoting",
  "assumptions": {
    "prices": {
      "s3_standard_storage": {
        "value": 0.023,
        "unit": "USD per GB-month",
        "label": "list price assumption, verify before quoting",
        "as_of": "2026-10-15"
      },
      "s3_get_requests": {
        "value": 0.0004,
        "unit": "USD per 1,000 GET requests",
        "label": "list price assumption, verify before quoting",
        "as_of": "2026-10-15"
      },
      "lambda_compute": {
        "value": 1.66667e-05,
        "unit": "USD per GB-second",
        "label": "list price assumption, verify before quoting",
        "as_of": "2026-10-15"
      },
      "lambda_requests": {
        "value": 0.2,
        "unit": "USD per 1,000,000 invocations",
        "label": "list price assumption, verify before quoting",
        "as_of": "2026-10-15"
      },
      "egress": {
        "value": 0,
        "unit": "ignored",
        "label": "assumed same-region, not charged",
        "as_of": "2026-10-15"
      }
    },
    "gb_definition": "1 GB = 2^30 bytes (S3 billing convention); decimal MB shown only for readability",
    "tiles": {
      "grid_cells_between_30N_and_30S": 216,
      "grid_cells_method": "36 longitude columns x 6 ten-degree latitude bands (30N-20N ... 20S-30S)",
      "tropical_belt_land_tiles": 100,
      "tropical_belt_method": "assumption, not a count: about 100 of the 216 grid cells hold substantial land. No land-mask dataset was used.",
      "global_land_tiles": 280,
      "global_method": "assumption (~280 Hansen land tiles)",
      "scaling": "linear in tile count. The measured tile is 13.7% land, so storage and re-check are shown on three bases: measured_tile (bytes as measured), half_land_assumption (bytes per land cell x 50% land) and all_land_scenario (bytes per land cell x every cell; a rough ceiling that assumes all land is as complex as this tile's)"
    },
    "measured_tile": {
      "name": "Hansen 10N_090E (0-10N, 90-100E) and JRC GFC2020 v4 N10_E90",
      "land_fraction_percent": 13.73
    },
    "versions_kept_rows": [
      1,
      5
    ],
    "registered_plots": 10000000,
    "per_plot_microseconds": {
      "original_v1": 84.51,
      "original_v1_source": "artifacts/decision/benchmark-v1.json cost_inputs.original_us: pooled hot medians, 17 supplied plots (W1): P5d precomputed-hash variant, P0, P4",
      "decision_registry": 1.9,
      "decision_registry_source": "artifacts/decision/benchmark-v1.json cost_inputs.registry_us: pooled hot medians, 17 supplied plots (W1): P5d precomputed-hash variant, P0, P4",
      "decision_new_polygon": 16.15,
      "decision_new_polygon_source": "artifacts/decision/benchmark-v1.json cost_inputs.new_polygon_us: pooled hot medians, 17 supplied plots (W1): P5d precomputed-hash variant, P0, P4"
    },
    "lambda": {
      "memory_gb": 1.0,
      "note": "same memory for every representation (no credit taken for the smaller working set)",
      "one_invocation_per_tile": true
    },
    "get_request_range_bytes": 8388608,
    "tile_decode_seconds": {
      "source": "original layers: artifacts/decision/tile-read-v1.json single_process_tile_read_seconds: median of 3 back-to-back single-process GDAL passes over the four tile files (2026-10-15, arm64 Darwin 10 cores). L0/L1/L2: scale-v1.json decode_timing (zstd decompress of the level-19 frames, single thread, warm cache, sampled strips scaled up)",
      "caveat": "warm-cache decode only: cold object-store latency and network time are not modelled; the original path would also need the JRC sampling step",
      "values": {
        "original_layers_geotiff": 2.091,
        "L0_yardstick_zstd19": 1.241,
        "L1_screen": 0.3,
        "L2_decision": 0.234
      }
    },
    "container": {
      "assumption": "ranged GETs and per-strip working memory assume a strip-indexed container that is NOT implemented. The shipped store (engine.decision_store) holds at most 16,384 cells per side and 16,777,216 cells, far below this tile's 1,600,000,000 cells; tile sizes here are zstd-19 per-strip sums (a yardstick) and ranged_gets_to_read_one_measured_tile is ceil(bytes / get_request_range_bytes), valid only for such a container.",
      "store_max_dimension": 16384,
      "store_max_cells": 16777216
    },
    "plots_per_tile": "the same 10 million plots are re-checked in both scopes; every tile in scope is read once per re-check (upper bound on tiles touched)"
  },
  "formulas": {
    "basis_factor": "measured_tile 1; half_land_assumption 0.5 * tile_cells / land_cells; all_land_scenario tile_cells / land_cells (bytes_per_tile = measured bytes * factor)",
    "storage_usd_per_month": "bytes_per_tile * tiles * versions / 2^30 * s3_standard_storage",
    "recheck_per_plot_seconds": "plots * per_plot_microseconds / 1e6",
    "recheck_lambda_usd": "(per_plot_seconds + tiles * tile_decode_seconds * factor) * memory_gb * lambda_per_gb_second + tiles * lambda_per_invocation",
    "recheck_get_usd": "tiles * ceil(bytes_per_tile / get_range_bytes) / 1000 * s3_get_per_1000"
  },
