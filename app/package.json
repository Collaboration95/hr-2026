{
  "name": "plotline-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-data": "python3 scripts/sync-data.py",
    "dev": "npm run sync-data && vite --host 127.0.0.1",
